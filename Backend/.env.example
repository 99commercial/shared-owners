PORT=5000
MONGODB_URI=mongodb://127.0.0.1:27017/shared_ownership
NODE_ENV=development
# Base URL of the frontend, used for links in emails (defaults to CORS_ORIGIN)
FRONTEND_URL=http://localhost:5001
JWT_ACCESS_SECRET=replace-with-a-long-random-string
JWT_REFRESH_SECRET=replace-with-a-different-long-random-string
JWT_ACCESS_EXPIRES_IN=15m
JWT_REFRESH_EXPIRES_IN=7d

# Behind nginx / a load balancer set the number of proxy hops (e.g. 1) so login IPs are the client's
TRUST_PROXY=false

# Email. Leave SMTP_HOST empty in development to print emails to the console instead
SMTP_HOST=
SMTP_PORT=587
# true for port 465 (implicit TLS), false for 587 (STARTTLS)
SMTP_SECURE=false
# true to check the SMTP login when the server starts
SMTP_VERIFY_ON_STARTUP=false
EMAIL_USER=
EMAIL_PASS=
EMAIL_FROM=SharedOwnership <no-reply@example.com>

# Used only by `npm run seed:admin`
ADMIN_EMAIL=admin@example.com
ADMIN_PASSWORD=replace-with-a-strong-password
ADMIN_FIRST_NAME=Platform
ADMIN_LAST_NAME=Admin

# Minutes a chat message can sit unread before the other person is emailed
CHAT_UNREAD_EMAIL_MINUTES=15

# Image uploads (profile photos)
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=
